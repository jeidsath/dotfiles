{
  "$schema": "https://opencode.ai/config.json",

  "share": "disabled",

  "plugin": [
    [
      "opencode-auto-permissions",
      {
        "model": "amazon-bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0",
        "sessionApprovals": true,
        "timeoutMs": 30000,
        "userMessageCount": 8,
        "shadow": false,
        "debug": true
      }
    ]
  ],

  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "us-east-1",
        "profile": "bedrock-coding"
      }
    },

    "fireworks-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Fireworks AI",
      "options": {
        "baseURL": "https://api.fireworks.ai/inference/v1",
        "apiKey": "{env:FIREWORKS_API_KEY}"
      },
      "models": {
        "accounts/fireworks/models/minimax-m3": {
          "name": "MiniMax M3",
          "limit": {
            "context": 1000000,
            "output": 32768
          }
        },

        "accounts/fireworks/models/glm-5p2": {
          "name": "GLM 5.2",
          "limit": {
            "context": 1040000,
            "output": 65536
          }
        }
      }
    },

    "llamaserver": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:UD-Q4_K_XL": {
          "name": "Qwen3-Coder-30B-A3B (local, free)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  },

  "small_model": "amazon-bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0",

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  "permission": {
    "edit": "allow",

    "bash": {
      "*": "allow",

      "rm *": "ask",
      "rmdir *": "ask",

      "sudo *": "ask",

      "git push": "ask",
      "git push *": "ask",
      "git reset --hard*": "ask",
      "git clean -f*": "ask",
      "git clean -df*": "ask",
      "git branch -D *": "ask",
      "git restore *": "ask",
      "git checkout -- *": "ask",
      "git stash drop*": "ask",
      "git stash clear*": "ask",

      "curl * | *sh*": "ask",
      "curl * | *bash*": "ask",
      "wget * | *sh*": "ask",
      "wget * | *bash*": "ask",

      "npm publish*": "ask",
      "pnpm publish*": "ask",
      "yarn npm publish*": "ask",

      "kubectl apply *": "ask",
      "kubectl delete *": "ask",
      "kubectl replace *": "ask",
      "kubectl patch *": "ask",
      "kubectl scale *": "ask",
      "kubectl rollout restart *": "ask",

      "helm install *": "ask",
      "helm upgrade *": "ask",
      "helm uninstall *": "ask",

      "terraform apply*": "ask",
      "terraform destroy*": "ask",

      "tofu apply*": "ask",
      "tofu destroy*": "ask",

      "aws * delete-*": "ask",
      "aws * terminate-*": "ask",
      "aws * remove-*": "ask",
      "aws * update-*": "ask",
      "aws * create-*": "ask",
      "aws * put-*": "ask",

      "docker system prune*": "ask",
      "docker volume rm *": "ask",
      "docker volume prune*": "ask",
      "docker container prune*": "ask",
      "docker image prune*": "ask"
    },

    "external_directory": "ask",

    "webfetch": "allow",
    "websearch": "allow"
  },

  "agent": {
    "compaction": {
      "model": "amazon-bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0"
    },

    "01-local-build": {
      "description": "Free, fully-local routine coding with Qwen3-Coder-30B-A3B (llama-server)",
      "mode": "primary",
      "model": "llamaserver/unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:UD-Q4_K_XL"
    },

    "02-m3-build": {
      "description": "Low-cost agentic coding with MiniMax M3 on Fireworks",
      "mode": "primary",
      "model": "fireworks-ai/accounts/fireworks/models/minimax-m3"
    },

    "03-m3-plan": {
      "description": "Low-cost planning and analysis with MiniMax M3 on Fireworks",
      "mode": "subagent",
      "model": "fireworks-ai/accounts/fireworks/models/minimax-m3",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",

          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show": "allow",
          "git show *": "allow",

          "grep *": "allow",
          "rg *": "allow",
          "find *": "allow",
          "ls": "allow",
          "ls *": "allow",
          "pwd": "allow",

          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow"
        }
      }
    },

    "04-glm-5p2-build": {
      "description": "Strong open-model coding with GLM 5.2 on Fireworks",
      "mode": "primary",
      "model": "fireworks-ai/accounts/fireworks/models/glm-5p2"
    },

    "05-glm-5p2-plan": {
      "description": "Strong open-model planning and analysis with GLM 5.2 on Fireworks",
      "mode": "subagent",
      "model": "fireworks-ai/accounts/fireworks/models/glm-5p2",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",

          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show": "allow",
          "git show *": "allow",

          "grep *": "allow",
          "rg *": "allow",
          "find *": "allow",
          "ls": "allow",
          "ls *": "allow",
          "pwd": "allow",

          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow"
        }
      }
    },

    "06-sonnet-build": {
      "description": "Mid-tier everyday coding with Claude Sonnet 5",
      "mode": "primary",
      "model": "amazon-bedrock/us.anthropic.claude-sonnet-5"
    },

    "07-opus-build": {
      "description": "Implement difficult changes with Claude Opus 5",
      "mode": "primary",
      "model": "amazon-bedrock/us.anthropic.claude-opus-5"
    },

    "08-opus-plan": {
      "description": "Plan difficult changes with Claude Opus 5",
      "mode": "subagent",
      "model": "amazon-bedrock/us.anthropic.claude-opus-5",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",

          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show": "allow",
          "git show *": "allow",

          "grep *": "allow",
          "rg *": "allow",
          "find *": "allow",
          "ls": "allow",
          "ls *": "allow",
          "pwd": "allow",

          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow"
        }
      }
    }
  },

  "default_agent": "02-m3-build"
}
